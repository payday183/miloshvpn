COMPOSE_PROJECT_NAME=miloshvpn
APP_PORT=8080
DEV_APP_PORT=8081
DEPLOY_BRANCH=main

POSTGRES_USER=milosh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=miloshvpn

BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
ADMIN_WEB_TOKEN=
ADMIN_PANEL_URL=http://localhost:8081/admin

MY_3X_Ui_login=admin
MY_3X_UI_Password=

DONATIONALERTS_TOKEN=
DONATIONALERTS_DONATE_URL=
DONATIONALERTS_POLL_INTERVAL_SECONDS=45
DONATIONALERTS_FETCH_LIMIT=50
DONATIONALERTS_FETCH_PAGES=3
PAYMENT_AMOUNT_TOLERANCE_RUB=2.00

X3UI_MODE=mock
X3UI_BASE_URL=https://host.docker.internal:24475
X3UI_WEB_BASE_PATH=
X3UI_TLS_VERIFY=false
X3UI_USERNAME=admin
X3UI_PASSWORD=admin
X3UI_INBOUND_ID=1
X3UI_MAX_CLIENTS=10
X3UI_USER_INBOUND_IDS=
X3UI_ADMIN_INBOUND_IDS=
X3UI_PUBLIC_INBOUND_IDS=
X3UI_SUB_BASE_URL=
X3UI_USER_LIMIT_IP=2
X3UI_ADMIN_LIMIT_IP=1
X3UI_PUBLIC_LIMIT_IP=0
NODE_SELECTION_MODE=least_loaded
NODE_OVERLOAD_CPU_PERCENT=85
NODE_OVERLOAD_MEMORY_PERCENT=90
NODE_OVERLOAD_DISK_PERCENT=90
VLESS_PUBLIC_HOST=127.0.0.1
VLESS_PUBLIC_PORT=8443
VLESS_QUERY=type=tcp&security=none
ADMIN_REALITY_INBOUND_ID=2
ADMIN_REALITY_PUBLIC_HOST=127.0.0.1
ADMIN_REALITY_PUBLIC_PORT=443
ADMIN_REALITY_PUBLIC_KEY=PUBLIC_KEY
ADMIN_REALITY_VLESS_QUERY=

PUBLIC_KEY_ENABLED=true
PUBLIC_KEY_ROTATE_HOURS=24
PUBLIC_KEY_POST_INTERVAL_HOURS=48
PUBLIC_KEY_TRAFFIC_GB=500
PUBLIC_KEY_POST_HOUR_MSK=14
PUBLIC_KEY_CHAT_ID=
FREE_TRIAL_ENABLED=true
FREE_TRIAL_DAYS=7
FREE_TRIAL_TRAFFIC_GB=500
NODE_STATUS_POLL_INTERVAL_SECONDS=3600
EXPIRED_SUBSCRIPTION_CLEANUP_ENABLED=true
EXPIRED_SUBSCRIPTION_CLEANUP_INTERVAL_SECONDS=86400
