COMPOSE_PROJECT_NAME=miloshvpn
APP_PORT=8080
DEV_APP_PORT=8081
DEPLOY_BRANCH=main

POSTGRES_USER=milosh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=miloshvpn

BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
ADMIN_WEB_TOKEN=
ADMIN_PANEL_URL=http://localhost:8081/admin

MY_3X_Ui_login=admin
MY_3X_UI_Password=

DONATIONALERTS_TOKEN=
DONATIONALERTS_DONATE_URL=
DONATIONALERTS_POLL_INTERVAL_SECONDS=45
DONATIONALERTS_FETCH_LIMIT=50
DONATIONALERTS_FETCH_PAGES=3
PAYMENT_AMOUNT_TOLERANCE_RUB=2.00

X3UI_MODE=mock
X3UI_BASE_URL=https://host.docker.internal:24475
X3UI_WEB_BASE_PATH=
X3UI_TLS_VERIFY=false
X3UI_TIMEOUT_SECONDS=20
X3UI_USERNAME=admin
X3UI_PASSWORD=admin
X3UI_INBOUND_ID=1
X3UI_MAX_CLIENTS=10
X3UI_USER_INBOUND_IDS=
X3UI_ADMIN_INBOUND_IDS=
X3UI_PUBLIC_INBOUND_IDS=
X3UI_SUB_BASE_URL=
X3UI_USER_LIMIT_IP=2
X3UI_ADMIN_LIMIT_IP=1
X3UI_PUBLIC_LIMIT_IP=0
NODE_SELECTION_MODE=least_loaded
NODE_OVERLOAD_CPU_PERCENT=85
NODE_OVERLOAD_MEMORY_PERCENT=90
NODE_OVERLOAD_DISK_PERCENT=90
VLESS_PUBLIC_HOST=127.0.0.1
VLESS_PUBLIC_PORT=8443
VLESS_QUERY=type=tcp&security=none
ADMIN_REALITY_INBOUND_ID=2
ADMIN_REALITY_PUBLIC_HOST=127.0.0.1
ADMIN_REALITY_PUBLIC_PORT=443
ADMIN_REALITY_PUBLIC_KEY=PUBLIC_KEY
ADMIN_REALITY_VLESS_QUERY=

PUBLIC_KEY_ENABLED=true
PUBLIC_KEY_ROTATE_HOURS=24
PUBLIC_KEY_POST_INTERVAL_HOURS=48
PUBLIC_KEY_TRAFFIC_GB=500
PUBLIC_KEY_POST_HOUR_MSK=14
PUBLIC_KEY_CHAT_ID=
FREE_TRIAL_ENABLED=true
FREE_TRIAL_DAYS=7
FREE_TRIAL_TRAFFIC_GB=500
NODE_STATUS_POLL_INTERVAL_SECONDS=3600
EXPIRED_SUBSCRIPTION_CLEANUP_ENABLED=true
EXPIRED_SUBSCRIPTION_CLEANUP_INTERVAL_SECONDS=86400

# Direct-node admin test. Main system 3x-ui remains configured above.
APP_ENV=test
NODE_PROVISIONING_MODE=direct_node
ENABLE_DIRECT_NODE_PROVISIONING=false
ENABLE_NODE_AGENT=false
DRY_RUN_FIRST=true

ADMIN_TEST_ENABLED=false
ADMIN_TEST_USER_ID=0
ADMIN_TEST_TELEGRAM_ID=0
ADMIN_TEST_NODE_ID=de-1
ADMIN_TEST_COUNTRY_CODE=DE
ADMIN_TEST_COUNTRY_FLAG=🇩🇪
ADMIN_TEST_CREATE_SUB=false
ADMIN_TEST_PROFILES_COUNT=5

SUBSCRIPTION_MODE=single_sub_with_5_profiles
SUBSCRIPTION_TITLE_TEMPLATE=Germany Test {user_id}
SUBSCRIPTION_BASE_URL=
SUBSCRIPTION_PUBLIC_HOST=
SUBSCRIPTION_TOKEN_SECRET=

# First direct German node. Inbounds are created automatically per admin/user; do not list inbound IDs here.
NODE_DE_1_ID=de-1
NODE_DE_1_NAME=Germany-1
NODE_DE_1_COUNTRY_CODE=DE
NODE_DE_1_COUNTRY_FLAG=🇩🇪
NODE_DE_1_PUBLIC_HOST=
NODE_DE_1_PUBLIC_IP=
NODE_DE_1_3XUI_BASE_URL=
NODE_DE_1_3XUI_USERNAME=
NODE_DE_1_3XUI_PASSWORD=
NODE_DE_1_3XUI_VERIFY_TLS=false
NODE_DE_1_3XUI_TIMEOUT_SECONDS=20
NODE_DE_1_AGENT_URL=
NODE_DE_1_AGENT_TOKEN=
NODE_DE_1_AGENT_VERIFY_TLS=false
NODE_DE_1_AGENT_TIMEOUT_SECONDS=20
NODE_DE_1_VPN_PORT_MIN=30000
NODE_DE_1_VPN_PORT_MAX=39999
NODE_DE_1_RESERVED_PORTS=22,443,44217,2096,5353,6881-6999,6969,51413,1337,2710

PORT_ALLOCATOR_SCOPE=per_node
PROFILE_SPEED_LIMIT_MBIT=40
PROFILE_SPEED_LIMIT_LABEL=5MBps
TC_LIMIT_ENABLED=true
FIREWALL_AUTO_OPEN_PORTS=true
FIREWALL_PROVIDER=ufw
INBOUND_POOL_ENABLED=true
INBOUND_DELETE_ON_USER_MOVE=false
INBOUND_REUSE_FREE_SLOTS=true
INBOUND_SLOT_ID_PREFIX=DE
INBOUND_NAME_TEMPLATE={flag} {node_code}-SLOT-{slot_number}-{protocol}
CLIENT_EMAIL_TEMPLATE=u{user_id}-{protocol}-{slot_number}
CLIENT_REMARK_TEMPLATE=admin-test-u{user_id}-{protocol}

R1_REALITY_PUBLIC_KEY=
R1_REALITY_PRIVATE_KEY=
R1_REALITY_DEST=www.amd.com:443
R1_REALITY_UTLS=safari
R1_REALITY_SPIDER_X=/

R2_REALITY_PUBLIC_KEY=
R2_REALITY_PRIVATE_KEY=
R2_REALITY_DEST=www.sony.com:443
R2_REALITY_UTLS=edge
R2_REALITY_SPIDER_X=/
R2_TRANSPORT=xhttp
R2_XHTTP_PATH=/
R2_XHTTP_MODE=auto
R2_XHTTP_PADDING_BYTES=100-1000

H3_PROTOCOL=hysteria
H3_TLS_ENABLED=true
H3_TLS_SNI=
H3_TLS_CERT_FILE=/root/cert/ip/fullchain.pem
H3_TLS_KEY_FILE=/root/cert/ip/privkey.pem
H3_TLS_MIN_VERSION=1.2
H3_TLS_MAX_VERSION=1.3
H3_UTLS=safari
H3_OCSP_STAPLING_SECONDS=3600
H3_DECRYPT=
H3_ENCRYPT=
H3_AUTH=X25519
H3_VISION_SEED=

R4_REALITY_PUBLIC_KEY=
R4_REALITY_PRIVATE_KEY=
R4_REALITY_DEST=www.intel.com:443
R4_REALITY_UTLS=edge
R4_REALITY_SPIDER_X=/

R5_REALITY_PUBLIC_KEY=
R5_REALITY_PRIVATE_KEY=
R5_REALITY_DEST=www.amd.com:443
R5_REALITY_UTLS=random
R5_REALITY_SPIDER_X=/
