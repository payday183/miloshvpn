table inet miloshvpn_abuse_guard {
  set blocked_tcp_ports {
    type inet_service
    flags interval
    elements = {
      1080,
      1337,
      2710,
      3128,
      6881-6999,
      8118,
      9001,
      9030,
      9040,
      9050-9051,
      51413,
      9150-9151
    }
  }

  set blocked_udp_ports {
    type inet_service
    flags interval
    elements = {
      6881-6999,
      51413,
      33434-33534
    }
  }

  chain output {
    type filter hook output priority 0; policy accept;
    tcp dport @blocked_tcp_ports counter reject
    udp dport @blocked_udp_ports counter reject
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
    tcp dport @blocked_tcp_ports counter reject
    udp dport @blocked_udp_ports counter reject
  }
}
